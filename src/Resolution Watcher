#!/bin/zsh
set -u

DISPLAYPLACER="/opt/homebrew/bin/displayplacer"
LSAPPINFO="/usr/bin/lsappinfo"
CONFIG_FILE="${RESOLUTION_WATCHER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/resolution-watcher/config.zsh}"
LOG_FILE="${RESOLUTION_WATCHER_LOG:-$HOME/Library/Logs/resolution-watcher.log}"

WATCHED_BUNDLE_ID="com.blizzard.worldofwarcraft"
GAME_MODE=""
WORK_MODE=""

log() {
  print -r -- "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG_FILE"
}

if [[ -r "$CONFIG_FILE" ]]; then
  source "$CONFIG_FILE"
else
  log "missing config at $CONFIG_FILE"
  exit 78
fi

if [[ -z "$WATCHED_BUNDLE_ID" || -z "$GAME_MODE" || -z "$WORK_MODE" ]]; then
  log "config must set WATCHED_BUNDLE_ID, GAME_MODE, and WORK_MODE"
  exit 78
fi

WATCHED_BUNDLE_ID_LOWER="${WATCHED_BUNDLE_ID:l}"

set_mode() {
  local mode="$1"

  if [[ ! -x "$DISPLAYPLACER" ]]; then
    log "displayplacer missing at $DISPLAYPLACER"
    return 1
  fi

  "$DISPLAYPLACER" "$mode" >> "$LOG_FILE" 2>&1
}

watched_app_registered() {
  [[ -n "$("$LSAPPINFO" find "bundleid=$WATCHED_BUNDLE_ID" 2>/dev/null)" ]]
}

state="work"
if watched_app_registered; then
  state="game"
  log "$WATCHED_BUNDLE_ID already running; switching to game mode"
  set_mode "$GAME_MODE"
fi

log "lsappinfo event watcher started"

"$LSAPPINFO" listen +kLSNotifyApplicationLaunch +kLSNotifyApplicationDeath forever |
while IFS= read -r event; do
  [[ "$event" == *"CFBundleIdentifier\"=\"$WATCHED_BUNDLE_ID\""* || "$event" == *"BundleIdentifierLowerCase\"=\"$WATCHED_BUNDLE_ID_LOWER\""* ]] || continue

  if [[ "$event" == Notification:\ kLSNotifyApplicationLaunch* && "$state" != "game" ]]; then
    state="game"
    log "$WATCHED_BUNDLE_ID detected; switching to game mode"
    set_mode "$GAME_MODE"
  elif [[ "$event" == Notification:\ kLSNotifyApplicationDeath* && "$state" != "work" ]]; then
    state="work"
    log "$WATCHED_BUNDLE_ID closed; restoring work mode"
    set_mode "$WORK_MODE"
  fi
done
